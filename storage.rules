rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /child-photos/{childId}/profile.jpg {
   function signed() { return request.auth != null; }
   function admin() { return signed() && request.auth.uid == 'mcS8mHznpaQm5qSk0mXEbfuiBWH3'; }
   function child() { return firestore.exists(/databases/(default)/documents/profiles/$(childId)) && firestore.get(/databases/(default)/documents/profiles/$(childId)).data.role == 'child'; }
   function guardian() { return signed() && child() && request.auth.uid in firestore.get(/databases/(default)/documents/profiles/$(childId)).data.guardianIds && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.role == 'guardian' && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.status == 'active'; }
   allow read: if admin() || guardian() || (signed() && request.auth.uid == childId);
   allow write: if (admin() || guardian()) && child() && (request.resource == null || (request.resource.size < 300 * 1024 && request.resource.contentType == 'image/jpeg'));
  }
 }
}
